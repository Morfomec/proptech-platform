// ============================================================
// PROPTECH PLATFORM — CONSOLIDATED ERD (VERSION 02)
// Model: Property-Centric MVP
// Stack: Django + Django REST Framework + PostgreSQL
// Architecture: Modular Monolith
// Primary keys: UUID
//
// IMPORTANT:
// Comments marked IMPLEMENTATION NOTE describe constraints
// that must be implemented using Django migrations, PostgreSQL
// constraints, or transactional service methods.
// ============================================================


// ============================================================
// 1. ACCOUNTS
// ============================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]

  email varchar(254) [not null, unique]
  password varchar(128) [not null]

  first_name varchar(150) [not null, default: '']
  last_name varchar(150) [not null, default: '']

  is_active boolean [not null, default: true]
  is_staff boolean [not null, default: false]
  is_superuser boolean [not null, default: false]

  last_login timestamptz
  email_verified_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  // IMPLEMENTATION NOTE:
  // Subclass AbstractBaseUser and PermissionsMixin for the custom user model.
  // This cleanly eliminates the username field, using email as the sole USERNAME_FIELD.
  // Enforce normalized email with case-insensitive uniqueness in the manager and serializer.
  // Django's PermissionsMixin provides groups and user_permissions join tables automatically.
}

Table user_profiles {
  id uuid [pk, default: `gen_random_uuid()`]

  user_id uuid [not null, unique]

  phone_number varchar(20)
  profile_image varchar(500)
  bio text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Ref: user_profiles.user_id - users.id



Table social_accounts {
  id uuid [pk, default: `gen_random_uuid()`]

  user_id uuid [not null]
  provider varchar(30) [not null]
  provider_user_id varchar(255) [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_user_id) [unique]
    (user_id, provider) [unique]
  }
}

Ref: social_accounts.user_id > users.id


// ============================================================
// 2. PROPERTIES (CENTRAL RENTABLE ASSET)
// ============================================================

Table properties {
  id uuid [pk, default: `gen_random_uuid()`]

  owner_id uuid [not null]

  title varchar(200) [not null]
  description text

  category varchar(20) [not null]
  property_type varchar(30) [not null]

  address_line_1 varchar(255) [not null]
  address_line_2 varchar(255)

  landmark varchar(255)
  locality varchar(120) [not null]

  city varchar(100) [not null]
  district varchar(100) [not null]
  state varchar(100) [not null]

  pin_code varchar(10) [not null]
  country_code char(2) [not null, default: 'IN']

  // Map-based location
  latitude decimal(10,7)
  longitude decimal(10,7)

  built_up_area numeric(10,2)

  // Physical specifications (residential fields nullable for commercial)
  bedrooms smallint
  bathrooms numeric(3,1)
  furnishing_status varchar(20)

  // Parking availability and details
  parking_spaces integer [default: 0]
  parking_details varchar(100)

  status varchar(20) [not null, default: 'draft']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_id, status)
    (category, property_type)
    (city, locality)
    (status, created_at)
  }

  // IMPLEMENTATION NOTES:
  // 1. category must be one of: 'residential', 'commercial'.
  // 2. property_type validation:
  //    - If category = 'residential': 'independent_house', 'villa', 'apartment', 'studio_apartment', 'other'.
  //    - If category = 'commercial': 'office', 'shop', 'showroom', 'warehouse', 'other'.
  //    - Category and property_type are strictly separate fields.
  // 3. bedrooms and bathrooms:
  //    - Required (>= 0) for residential before publishing.
  //    - Nullable for commercial properties (offices, shops, showrooms, warehouses).
  // 4. furnishing_status:
  //    - Controlled values: 'unfurnished', 'semi_furnished', 'fully_furnished' (or NULL where not applicable).
  // 5. built_up_area:
  //    - built_up_area > 0 when supplied (expressed in sq ft).
  // 6. parking_spaces:
  //    - parking_spaces >= 0. Default 0 indicates no reserved parking.
  // 7. Coordinates:
  //    - Latitude must be between -90 and 90.
  //    - Longitude must be between -180 and 180.
  //    - Both coordinates must be NULL or both populated.
  //    - Coordinates are required before publishing.
  //    - Draft properties may have NULL coordinates.
  // 8. PIN code:
  //    - When country_code = 'IN', validate the 6-digit Indian PIN format using a Django model validator.
  // 9. Rental Pricing Architecture Decision:
  //    - In this property-centric design, asking rental terms (monthly_rent, security_deposit, available_from)
  //      belong exclusively to `listings`, while agreed contract terms belong to `tenancies`.
  //    - We deliberately avoid duplicating monthly_rent and security_deposit on `properties` to maintain a single
  //      source of truth for marketing terms and prevent data drift between the physical asset and listings.
}

Ref: properties.owner_id > users.id


Table property_images {
  id uuid [pk, default: `gen_random_uuid()`]

  property_id uuid [not null]

  image_url varchar(1000) [not null]
  caption varchar(255)

  display_order integer [not null, default: 0]
  is_primary boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (property_id, display_order)
  }

  // IMPLEMENTATION REQUIREMENT (PostgreSQL / Django):
  // DBML index syntax cannot enforce partial conditions (WHERE clauses).
  // Implement as a PostgreSQL partial unique index via Django Meta.constraints:
  // UniqueConstraint(fields=['property_id'], condition=Q(is_primary=True), name='uq_property_single_primary_image')
  // This guarantees at most one primary image per property.
  //
  // ARCHITECTURAL CONSOLIDATION DECISION:
  // In the property-centric MVP, property_images serves as the single authoritative photo gallery
  // for both property management and public marketing listings. A separate listing_images table is removed
  // to avoid redundant photo uploads and dual-table synchronization overhead.
}

Ref: property_images.property_id > properties.id


// ============================================================
// 2A. AMENITIES
// ============================================================

Table amenities {
  id uuid [pk, default: `gen_random_uuid()`]

  name varchar(100) [not null, unique]
  category varchar(50) [not null]
  description varchar(255)
  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (category, is_active)
  }

  // IMPLEMENTATION NOTE:
  // Amenities catalogue covers both residential and commercial assets.
  // Controlled categories: 'building', 'safety', 'hvac', 'power_backup', 'connectivity',
  // 'recreation', 'appliance', 'accessibility'.
}

Table property_amenities {
  id uuid [pk, default: `gen_random_uuid()`]

  property_id uuid [not null]
  amenity_id uuid [not null]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (property_id, amenity_id) [unique]
    (amenity_id)
  }
}

Ref: property_amenities.property_id > properties.id
Ref: property_amenities.amenity_id > amenities.id


// ============================================================
// 3. LISTINGS
// ============================================================

Table listings {
  id uuid [pk, default: `gen_random_uuid()`]

  property_id uuid [not null]

  title varchar(200) [not null]
  description text

  monthly_rent numeric(12,2) [not null]
  security_deposit numeric(12,2)

  available_from date

  status varchar(20) [not null, default: 'draft']

  published_at timestamptz

  review_status varchar(20) [not null, default: 'pending']

  reviewed_by_id uuid
  reviewed_at timestamptz
  rejection_reason text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, published_at)
    (property_id, status)
    (review_status, status)
  }

  // IMPLEMENTATION REQUIREMENT (PostgreSQL / Django):
  // Check constraints: monthly_rent >= 0, security_deposit >= 0.
  //
  // DBML index syntax cannot enforce partial conditions (WHERE clauses).
  // Implement as a PostgreSQL partial unique index via Django Meta.constraints:
  // UniqueConstraint(fields=['property_id'], condition=Q(status__in=['draft', 'published', 'paused']), name='uq_property_single_open_listing')
  //
  // This permits at most one open listing per property. Closed listings do not block new listings.
  // Listing publication and approval policy:
  // - When mandatory approval is ON: Search results filter by status = 'published' AND review_status = 'approved'.
  // - When mandatory approval is OFF: Search results filter by status = 'published' directly (or publishing auto-approves).
  // Only listings permitted by the configured approval policy may appear in public search results.
}

Ref: listings.property_id > properties.id
Ref: listings.reviewed_by_id > users.id


Table saved_properties {
  id uuid [pk, default: `gen_random_uuid()`]

  user_id uuid [not null]
  property_id uuid [not null]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, property_id) [unique]
    (user_id, created_at)
    (property_id)
  }
}

Ref: saved_properties.user_id > users.id
Ref: saved_properties.property_id > properties.id


// ============================================================
// 4. RENTAL APPLICATIONS
// ============================================================

Table applications {
  id uuid [pk, default: `gen_random_uuid()`]

  listing_id uuid [not null]
  applicant_id uuid [not null]

  status varchar(20) [not null, default: 'submitted']

  message text

  reviewed_at timestamptz
  reviewed_by_id uuid

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (listing_id, status)
    (applicant_id, created_at)
    (listing_id, applicant_id) [unique]
  }

  // IMPLEMENTATION NOTE:
  // Permitted statuses: 'submitted', 'under_review', 'approved', 'rejected', 'withdrawn'.
  // Only authorized users may review an application.
  // Update application status and insert status history within the same database transaction.
}

Ref: applications.listing_id > listings.id
Ref: applications.applicant_id > users.id
Ref: applications.reviewed_by_id > users.id


Table application_status_history {
  id uuid [pk, default: `gen_random_uuid()`]

  application_id uuid [not null]

  previous_status varchar(20)
  new_status varchar(20) [not null]

  changed_by_id uuid
  change_reason text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at)
  }

  // IMPLEMENTATION NOTE:
  // Treat history as append-only.
  // Insert a history record whenever the application status changes.
}

Ref: application_status_history.application_id > applications.id
Ref: application_status_history.changed_by_id > users.id


// ============================================================
// 5. TENANCIES
// ============================================================

Table tenancies {
  id uuid [pk, default: `gen_random_uuid()`]

  property_id uuid [not null]
  tenant_id uuid [not null]
  application_id uuid [unique]

  start_date date [not null]
  end_date date

  monthly_rent numeric(12,2) [not null]
  security_deposit numeric(12,2) [not null, default: 0]

  rent_due_day smallint [not null, default: 1]

  status varchar(20) [not null, default: 'pending']

  actual_move_in_date date
  actual_move_out_date date

  notes text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (property_id, status)
    (tenant_id, status)
    (start_date, end_date)
  }

  // IMPLEMENTATION NOTE:
  // CHECK end_date IS NULL OR end_date >= start_date
  // CHECK monthly_rent >= 0
  // CHECK security_deposit >= 0
  // CHECK rent_due_day BETWEEN 1 AND 28
  //
  // Permitted statuses: 'pending', 'confirmed', 'active', 'ended', 'cancelled'.
  // Validate actual move-in/out dates and permitted statuses.
  //
  // APPLICATION CONSISTENCY:
  // If application_id is supplied, verify that the application belongs to tenant_id
  // and refers to a listing for this property (listing.property_id = tenancies.property_id).
  //
  // OVERLAPPING TENANCIES (POSTGRESQL EXCLUSION CONSTRAINT):
  // Prevent overlapping date ranges for confirmed and active tenancies belonging to the same property.
  // Pending, ended, and cancelled tenancies do NOT reserve the property.
  //
  // Implement as a PostgreSQL exclusion constraint via Django migration using btree_gist extension:
  // ALTER TABLE tenancies ADD CONSTRAINT excl_tenancy_property_no_overlap
  // EXCLUDE USING gist (
  //   property_id WITH =,
  //   daterange(start_date, COALESCE(end_date, 'infinity'::date), '[]') WITH &&
  // )
  // WHERE (status IN ('confirmed', 'active'));
  //
  // For concurrency-sensitive creation and activation, use transaction.atomic()
  // and select_for_update() on the property record.
  // Recheck property availability before transitioning a pending tenancy to confirmed/active.
  // A row lock alone is not a substitute for the database exclusion constraint.
}

Ref: tenancies.property_id > properties.id
Ref: tenancies.tenant_id > users.id
Ref: tenancies.application_id - applications.id


// ============================================================
// 6. RENT CHARGES
// ============================================================

Table rent_charges {
  id uuid [pk, default: `gen_random_uuid()`]

  tenancy_id uuid [not null]

  charge_type varchar(30) [not null, default: 'rent']

  billing_period_start date [not null]
  billing_period_end date [not null]

  due_date date [not null]

  amount numeric(12,2) [not null]

  status varchar(20) [not null, default: 'unpaid']

  description varchar(255)

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, tenancy_id) [unique]
    (tenancy_id, charge_type, billing_period_start) [unique]
    (status, due_date)
    (tenancy_id, due_date)
  }

  // IMPLEMENTATION NOTE:
  // CHECK amount > 0
  // CHECK billing_period_end >= billing_period_start
  //
  // (id, tenancy_id) [unique] enables composite foreign key referential integrity
  // from payment_allocations.(rent_charge_id, tenancy_id).
  //
  // The (tenancy_id, charge_type, billing_period_start) unique index allows
  // different charge types in the same billing period while preventing duplicate charges
  // of the same type for the same tenancy and billing-period start.
  //
  // Validate permitted charge types and statuses.
  // Derive unpaid/partially_paid/paid status from valid allocations.
  // Define explicit rules for waived and cancelled charges.
}

Ref: rent_charges.tenancy_id > tenancies.id


// ============================================================
// 7. PAYMENTS
// ============================================================

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]

  tenancy_id uuid [not null]

  amount numeric(12,2) [not null]
  currency char(3) [not null, default: 'INR']

  payment_method varchar(30) [not null]
  transaction_reference varchar(255)

  status varchar(20) [not null, default: 'pending']

  paid_at timestamptz

  notes text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenancy_id, created_at)
    (status, created_at)
    (transaction_reference)
    (id, tenancy_id) [unique]
  }

  // IMPLEMENTATION REQUIREMENT (PostgreSQL / Django):
  // CHECK amount > 0
  // Validate permitted payment methods and statuses.
  // Only successful/completed payments count toward settled balances.
  //
  // DBML index syntax cannot enforce partial conditions (WHERE clauses).
  // Implement a partial unique index via Django Meta.constraints:
  // UniqueConstraint(fields=['transaction_reference'], condition=Q(transaction_reference__isnull=False) & ~Q(transaction_reference=''), name='uq_payment_transaction_reference')
  // This prevents recording duplicate transaction reference IDs for non-cash receipts.
}

Ref: payments.tenancy_id > tenancies.id


Table payment_refunds {
  id uuid [pk, default: `gen_random_uuid()`]

  payment_id uuid [not null]

  amount numeric(12,2) [not null]
  currency char(3) [not null, default: 'INR']

  reason varchar(255) [not null]
  status varchar(20) [not null, default: 'pending']

  refund_reference varchar(255)
  processed_at timestamptz

  created_by uuid [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_id)
    (status, created_at)
    (created_by, created_at)
  }

  // REFUND VALIDATION:
  // Refund amount must be greater than zero.
  // Total successful refunds must not exceed the original payment amount.
  // Only successful payments can be refunded.
  // A refund must belong to the same tenancy as its original payment.
  // Record the external refund transaction reference when available.
}

Ref: payment_refunds.payment_id > payments.id
Ref: payment_refunds.created_by > users.id


// ============================================================
// 8. PAYMENT ALLOCATIONS
// ============================================================

Table payment_allocations {
  id uuid [pk, default: `gen_random_uuid()`]

  payment_id uuid [not null]
  rent_charge_id uuid [not null]

  // Redundant by design: enables composite foreign keys to ensure
  // the payment and charge belong to the same tenancy.
  tenancy_id uuid [not null]

  allocated_amount numeric(12,2) [not null]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_id, rent_charge_id) [unique]
    (rent_charge_id)
    (tenancy_id)
    (payment_id, tenancy_id)
    (rent_charge_id, tenancy_id)
  }

  // IMPLEMENTATION NOTE:
  // CHECK allocated_amount > 0
  //
  // Cross-table integrity:
  // The payment and charge must belong to the same tenancy.
  // Composite foreign keys below enforce this relationship.
  //
  // Transactional service requirements:
  // - Lock the payment and rent charge before allocating.
  // - Do not allocate more than the payment's eligible amount.
  // - Do not allocate more than the charge's outstanding balance.
  // - Count only completed payments toward settled balances.
  // - Update charge status and allocation atomically.
  //
  // These aggregate rules require transactional logic; a simple
  // CHECK constraint cannot enforce sums across multiple rows.
}

Ref: payment_allocations.(payment_id, tenancy_id) > payments.(id, tenancy_id)
Ref: payment_allocations.(rent_charge_id, tenancy_id) > rent_charges.(id, tenancy_id)


// ============================================================
// 9. NOTIFICATIONS
// ============================================================

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]

  user_id uuid [not null]

  notification_type varchar(50) [not null]
  title varchar(200) [not null]
  message text [not null]

  related_object_type varchar(50)
  related_object_id uuid

  is_read boolean [not null, default: false]
  read_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, is_read, created_at)
    (user_id, created_at)
  }

  // IMPLEMENTATION NOTE:
  // related_object_type + related_object_id is a polymorphic reference.
  // A standard foreign key cannot validate it against multiple tables.
  // Validate target objects in application logic.
  // Keep read_at and is_read consistent in the notification service.
}

Ref: notifications.user_id > users.id


// ============================================================
// 10. AUDIT LOGS
// ============================================================

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]

  actor_id uuid

  action varchar(100) [not null]

  entity_type varchar(50) [not null]
  entity_id uuid [not null]

  old_values jsonb
  new_values jsonb

  ip_address inet
  user_agent text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, created_at)
    (actor_id, created_at)
    (action, created_at)
  }

  // IMPLEMENTATION NOTE:
  // Treat audit records as append-only.
  // Do not log passwords, tokens, secrets, or sensitive document data.
}

Ref: audit_logs.actor_id > users.id


// ============================================================
// 11. DOCUMENTS
// ============================================================

Table documents {
  id uuid [pk, default: `gen_random_uuid()`]

  uploaded_by uuid [not null]

  property_id uuid
  application_id uuid
  tenancy_id uuid

  document_type varchar(50) [not null]

  file_url varchar(1000) [not null]
  original_filename varchar(255) [not null]

  mime_type varchar(100)
  file_size_bytes bigint

  status varchar(20) [not null, default: 'active']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (uploaded_by, created_at)
    (property_id, document_type)
    (application_id, document_type)
    (tenancy_id, document_type)
    (document_type, status)
  }

  // IMPLEMENTATION NOTE:
  // CHECK file_size_bytes > 0 when file_size_bytes is not null.
  // Explicit parent references: property_id, application_id, tenancy_id.
  // At most one of these three references can be populated:
  // CHECK (
  //   (CASE WHEN property_id IS NOT NULL THEN 1 ELSE 0 END +
  //    CASE WHEN application_id IS NOT NULL THEN 1 ELSE 0 END +
  //    CASE WHEN tenancy_id IS NOT NULL THEN 1 ELSE 0 END) <= 1
  // )
  // All three can remain NULL temporarily for an unattached document.
  // Rental agreements are stored as tenancy documents with document_type = 'rental_agreement'.
  // No separate rental_agreements table is used for the MVP.
  // Validate actual file content, type, size, ownership, and access permissions.
  // Store files in private object storage and issue authorized URLs.
}

Ref: documents.uploaded_by > users.id
Ref: documents.property_id > properties.id
Ref: documents.application_id > applications.id
Ref: documents.tenancy_id > tenancies.id


// ============================================================
// 12. SUBSCRIPTIONS
// ============================================================

Table subscription_plans {
  id uuid [pk, default: `gen_random_uuid()`]

  name varchar(50) [not null, unique]
  code varchar(30) [not null, unique]

  min_properties integer [not null]
  max_properties integer

  monthly_price numeric(10,2)
  currency char(3) [not null, default: 'INR']

  trial_duration_months smallint [not null, default: 3]

  is_active boolean [not null, default: true]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active)
  }

  // VALIDATION & QUOTA RULES:
  // min_properties >= 1.
  // max_properties must be NULL or >= min_properties.
  // monthly_price must be positive when supplied.
  // trial_duration_months >= 0.
  // NULL monthly_price represents custom pricing.
  // NULL max_properties represents no upper property limit.
  //
  // MVP Plan Tiers:
  // - Starter: min_properties = 1, max_properties = 5, monthly_price = 399.00 INR
  // - Growth: min_properties = 6, max_properties = 12, monthly_price = 799.00 INR
  // - Pro: min_properties = 13, max_properties = 25, monthly_price = 1199.00 INR
  // - Enterprise: min_properties = 26, max_properties = NULL, monthly_price = NULL (custom pricing)
  //
  // Quota Interpretation:
  // 1. One independently rentable property consumes one quota slot.
  // 2. Every property owned by the owner counts, regardless of listing publication status.
  // 3. Pausing or unpublishing a listing does not release quota.
  // 4. Deleting a property releases quota only when deletion is permitted by tenancy, financial and data-retention rules.
  // 5. Enforce quota when creating a property through a transaction-safe backend service:
  //    SELECT COUNT(*) FROM properties WHERE owner_id = :owner_id FOR UPDATE
}

Table subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]

  owner_id uuid [not null, unique]
  plan_id uuid [not null]

  status varchar(20) [not null, default: 'trialing']

  trial_started_at timestamptz
  trial_ends_at timestamptz

  current_period_start timestamptz
  current_period_end timestamptz

  started_at timestamptz
  cancelled_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (plan_id, status)
    (status, current_period_end)
  }

  // VALIDATION:
  // One subscription per owner account.
  // Trial end must be later than trial start.
  // Current period end must be later than current period start.
  // Validate permitted subscription statuses.
  // Plan changes must preserve previous payment records.
  // Expired or cancelled subscriptions must not delete owner data.
}

Ref: subscriptions.owner_id - users.id
Ref: subscriptions.plan_id > subscription_plans.id


Table subscription_payments {
  id uuid [pk, default: `gen_random_uuid()`]

  subscription_id uuid [not null]
  plan_id uuid [not null]

  amount numeric(10,2) [not null]
  currency char(3) [not null, default: 'INR']

  payment_method varchar(30)
  transaction_reference varchar(255)

  status varchar(20) [not null, default: 'pending']

  billing_period_start timestamptz
  billing_period_end timestamptz

  paid_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (subscription_id, created_at)
    (status, created_at)
    (transaction_reference)
  }

  // VALIDATION:
  // amount >= 0.
  // Validate permitted payment methods and statuses.
  // Only successful payments count as received revenue.
  // Store the plan applicable to each billing transaction.
  // Prevent duplicate external transaction references.
  // Preserve failed and pending transactions for auditability.
}

Ref: subscription_payments.subscription_id > subscriptions.id
Ref: subscription_payments.plan_id > subscription_plans.id
