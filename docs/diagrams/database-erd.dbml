// ============================================================
// PROPTECH PLATFORM — CONSOLIDATED ERD
// Stack: Django + Django REST Framework + PostgreSQL
// Architecture: Modular Monolith
// Primary keys: UUID
//
// IMPORTANT:
// Comments marked IMPLEMENTATION NOTE describe constraints
// that must be implemented using Django migrations or services.
// ============================================================


// ============================================================
// 1. ACCOUNTS
// ============================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]

  email varchar(254) [not null, unique]
  password varchar(128) [not null]

  first_name varchar(150) [not null, default: '']
  last_name varchar(150) [not null, default: '']

  is_active boolean [not null, default: true]
  is_staff boolean [not null, default: false]
  is_superuser boolean [not null, default: false]

  last_login timestamptz
  email_verified_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  // IMPLEMENTATION NOTE:
  // Use a Django custom user model based on AbstractUser.
  // Configure email-based authentication and remove the username
  // field if email is the sole login identifier.
  // Normalize email addresses and enforce case-insensitive uniqueness.
}

Table user_profiles {
  id uuid [pk, default: `gen_random_uuid()`]

  user_id uuid [not null, unique]

  phone_number varchar(20)
  profile_image varchar(500)
  bio text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Ref: user_profiles.user_id - users.id


// ============================================================
// 2. PROPERTIES AND UNITS
// ============================================================

Table properties {
  id uuid [pk, default: `gen_random_uuid()`]

  owner_id uuid [not null]

  name varchar(200) [not null]
  property_type varchar(30) [not null]
  description text

  address_line_1 varchar(255) [not null]
  address_line_2 varchar(255)

  landmark varchar(255)
  locality varchar(120) [not null]

  city varchar(100) [not null]
  district varchar(100) [not null]
  state varchar(100) [not null]

  pin_code char(6) [not null]
  country_code char(2) [not null, default: 'IN']

  status varchar(20) [not null, default: 'draft']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_id, status)
    (city, locality)
  }

  // IMPLEMENTATION NOTE:
  // Validate PIN code format and permitted property/status values.
}

Ref: properties.owner_id > users.id


Table units {
  id uuid [pk, default: `gen_random_uuid()`]

  property_id uuid [not null]

  unit_number varchar(50) [not null]
  unit_type varchar(30) [not null]

  floor_number integer
  bedrooms smallint [not null, default: 0]
  bathrooms smallint [not null, default: 1]

  area_sqft numeric(10,2)

  furnishing_status varchar(20) [not null, default: 'unfurnished']

  monthly_rent numeric(12,2)
  security_deposit numeric(12,2)

  status varchar(20) [not null, default: 'active']

  description text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (property_id, unit_number) [unique]
    (property_id, status)
  }

  // IMPLEMENTATION NOTE:
  // bedrooms >= 0
  // bathrooms >= 0
  // area_sqft > 0 when supplied
  // monthly_rent >= 0 when supplied
  // security_deposit >= 0 when supplied
  // Validate permitted unit, furnishing, and status values.
}

Ref: units.property_id > properties.id


Table property_images {
  id uuid [pk, default: `gen_random_uuid()`]

  property_id uuid [not null]

  image_url varchar(1000) [not null]
  caption varchar(255)

  display_order integer [not null, default: 0]
  is_primary boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (property_id, display_order)
  }

  // IMPLEMENTATION NOTE:
  // PostgreSQL partial unique index:
  // UNIQUE(property_id) WHERE is_primary = TRUE
  // This permits at most one primary image per property.
}

Ref: property_images.property_id > properties.id


// ============================================================
// 3. LISTINGS
// ============================================================

Table listings {
  id uuid [pk, default: `gen_random_uuid()`]

  unit_id uuid [not null]

  title varchar(200) [not null]
  description text

  monthly_rent numeric(12,2) [not null]
  security_deposit numeric(12,2)

  available_from date

  status varchar(20) [not null, default: 'draft']

  published_at timestamptz

  review_status varchar(20) [not null, default: 'pending']

  reviewed_by_id uuid
  reviewed_at timestamptz
  rejection_reason text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, published_at)
    (unit_id, status)
    (review_status, status)
  }

  // IMPLEMENTATION NOTE:
  // monthly_rent >= 0
  // security_deposit >= 0 when supplied
  //
  // PostgreSQL partial unique index:
  // UNIQUE(unit_id)
  // WHERE status IN ('draft', 'published', 'paused')
  //
  // This allows at most one open listing per unit.
  // Closed listings do not block a new listing.
  //
  // Listing publication and approval are separate concerns.
  // Only listings permitted by the configured approval policy
  // may appear in public search results.
}

Ref: listings.unit_id > units.id
Ref: listings.reviewed_by_id > users.id


Table listing_images {
  id uuid [pk, default: `gen_random_uuid()`]

  listing_id uuid [not null]

  image_url varchar(1000) [not null]
  caption varchar(255)

  display_order integer [not null, default: 0]
  is_primary boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (listing_id, display_order)
  }

  // IMPLEMENTATION NOTE:
  // PostgreSQL partial unique index:
  // UNIQUE(listing_id) WHERE is_primary = TRUE
  // This permits at most one primary image per listing.
}

Ref: listing_images.listing_id > listings.id


Table saved_properties {
  id uuid [pk, default: `gen_random_uuid()`]

  user_id uuid [not null]
  property_id uuid [not null]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, property_id) [unique]
    (user_id, created_at)
    (property_id)
  }
}

Ref: saved_properties.user_id > users.id
Ref: saved_properties.property_id > properties.id


// ============================================================
// 4. RENTAL APPLICATIONS
// ============================================================

Table applications {
  id uuid [pk, default: `gen_random_uuid()`]

  listing_id uuid [not null]
  applicant_id uuid [not null]

  status varchar(20) [not null, default: 'submitted']

  message text

  reviewed_at timestamptz
  reviewed_by_id uuid

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (listing_id, status)
    (applicant_id, created_at)
    (listing_id, applicant_id) [unique]
  }

  // IMPLEMENTATION NOTE:
  // Validate permitted application statuses.
  // Only authorized users may review an application.
  // Update application status and insert status history
  // within the same database transaction.
}

Ref: applications.listing_id > listings.id
Ref: applications.applicant_id > users.id
Ref: applications.reviewed_by_id > users.id


Table application_status_history {
  id uuid [pk, default: `gen_random_uuid()`]

  application_id uuid [not null]

  previous_status varchar(20)
  new_status varchar(20) [not null]

  changed_by_id uuid
  change_reason text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (application_id, created_at)
  }

  // IMPLEMENTATION NOTE:
  // Treat history as append-only.
  // Insert a history record whenever the application status changes.
}

Ref: application_status_history.application_id > applications.id
Ref: application_status_history.changed_by_id > users.id


// ============================================================
// 5. TENANCIES
// ============================================================

Table tenancies {
  id uuid [pk, default: `gen_random_uuid()`]

  unit_id uuid [not null]
  tenant_id uuid [not null]
  application_id uuid [unique]

  start_date date [not null]
  end_date date

  monthly_rent numeric(12,2) [not null]
  security_deposit numeric(12,2) [not null, default: 0]

  rent_due_day smallint [not null, default: 1]

  status varchar(20) [not null, default: 'pending']

  actual_move_in_date date
  actual_move_out_date date

  notes text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (unit_id, status)
    (tenant_id, status)
    (start_date, end_date)
  }

  // IMPLEMENTATION NOTE:
  // CHECK end_date IS NULL OR end_date >= start_date
  // CHECK monthly_rent >= 0
  // CHECK security_deposit >= 0
  // CHECK rent_due_day BETWEEN 1 AND 28
  //
  // Validate actual move-in/out dates and permitted statuses.
  //
  // APPLICATION CONSISTENCY:
  // If application_id is supplied, verify that the application
  // belongs to tenant_id and refers to a listing for this unit.
  //
  // OVERLAPPING TENANCIES:
  // Use a PostgreSQL exclusion constraint with a date range,
  // or equivalent carefully tested transactional protection.
  // Prevent overlapping scheduled/active tenancies for the same unit.
  // Decide whether pending tenancies also reserve the unit.
  //
  // For concurrency-sensitive creation/activation, use
  // transaction.atomic() and select_for_update() on the unit.
  // A row lock alone is not a substitute for a database exclusion
  // constraint if other write paths can bypass the service.
}

Ref: tenancies.unit_id > units.id
Ref: tenancies.tenant_id > users.id
Ref: tenancies.application_id - applications.id


// ============================================================
// 6. RENT CHARGES
// ============================================================

Table rent_charges {
  id uuid [pk, default: `gen_random_uuid()`]

  tenancy_id uuid [not null]

  charge_type varchar(30) [not null, default: 'rent']

  billing_period_start date [not null]
  billing_period_end date [not null]

  due_date date [not null]

  amount numeric(12,2) [not null]

  status varchar(20) [not null, default: 'unpaid']

  description varchar(255)

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenancy_id, charge_type, billing_period_start) [unique]
    (status, due_date)
    (tenancy_id, due_date)
  }

  // IMPLEMENTATION NOTE:
  // CHECK amount > 0
  // CHECK billing_period_end >= billing_period_start
  //
  // The unique index allows different charge types in the same
  // billing period while preventing duplicate charges of the same
  // type for the same tenancy and billing-period start.
  //
  // Validate permitted charge types and statuses.
  // Derive unpaid/partially_paid/paid status from valid allocations.
  // Define explicit rules for waived and cancelled charges.
}

Ref: rent_charges.tenancy_id > tenancies.id


// ============================================================
// 7. PAYMENTS
// ============================================================

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]

  tenancy_id uuid [not null]

  amount numeric(12,2) [not null]
  currency char(3) [not null, default: 'INR']

  payment_method varchar(30) [not null]
  transaction_reference varchar(255)

  status varchar(20) [not null, default: 'pending']

  paid_at timestamptz

  notes text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tenancy_id, created_at)
    (status, created_at)
    (transaction_reference)
    (id, tenancy_id) [unique]
  }

  // IMPLEMENTATION NOTE:
  // CHECK amount > 0
  // Validate permitted payment methods and statuses.
  //
  // Only successful/completed payments should count toward balances.
  //
  // Consider a PostgreSQL partial unique index on
  // (payment_method, transaction_reference)
  // WHERE transaction_reference IS NOT NULL
  // AND btrim(transaction_reference) <> ''.
  //
  // Confirm the reference uniqueness scope for the payment sources
  // you support before enabling that constraint.
}

Ref: payments.tenancy_id > tenancies.id


// ============================================================
// 8. PAYMENT ALLOCATIONS
// ============================================================

Table payment_allocations {
  id uuid [pk, default: `gen_random_uuid()`]

  payment_id uuid [not null]
  rent_charge_id uuid [not null]

  // Redundant by design: enables composite foreign keys to ensure
  // the payment and charge belong to the same tenancy.
  tenancy_id uuid [not null]

  allocated_amount numeric(12,2) [not null]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (payment_id, rent_charge_id) [unique]
    (rent_charge_id)
    (tenancy_id)
    (payment_id, tenancy_id)
    (rent_charge_id, tenancy_id)
  }

  // IMPLEMENTATION NOTE:
  // CHECK allocated_amount > 0
  //
  // Cross-table integrity:
  // The payment and charge must belong to the same tenancy.
  // Composite foreign keys below enforce this relationship.
  //
  // Transactional service requirements:
  // - Lock the payment and rent charge before allocating.
  // - Do not allocate more than the payment's eligible amount.
  // - Do not allocate more than the charge's outstanding balance.
  // - Count only completed payments toward settled balances.
  // - Update charge status and allocation atomically.
  //
  // These aggregate rules require transactional logic; a simple
  // CHECK constraint cannot enforce sums across multiple rows.
}

Ref: payment_allocations.(payment_id, tenancy_id) > payments.(id, tenancy_id)
Ref: payment_allocations.(rent_charge_id, tenancy_id) > rent_charges.(id, tenancy_id)


// ============================================================
// 9. NOTIFICATIONS
// ============================================================

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]

  user_id uuid [not null]

  notification_type varchar(50) [not null]
  title varchar(200) [not null]
  message text [not null]

  related_object_type varchar(50)
  related_object_id uuid

  is_read boolean [not null, default: false]
  read_at timestamptz

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, is_read, created_at)
    (user_id, created_at)
  }

  // IMPLEMENTATION NOTE:
  // related_object_type + related_object_id is a polymorphic reference.
  // A standard foreign key cannot validate it against multiple tables.
  // Validate target objects in application logic.
  // Keep read_at and is_read consistent in the notification service.
}

Ref: notifications.user_id > users.id


// ============================================================
// 10. AUDIT LOGS
// ============================================================

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]

  actor_id uuid

  action varchar(100) [not null]

  entity_type varchar(50) [not null]
  entity_id uuid [not null]

  old_values jsonb
  new_values jsonb

  ip_address inet
  user_agent text

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id, created_at)
    (actor_id, created_at)
    (action, created_at)
  }

  // IMPLEMENTATION NOTE:
  // Treat audit records as append-only.
  // Do not log passwords, tokens, secrets, or sensitive document data.
}

Ref: audit_logs.actor_id > users.id


// ============================================================
// 11. DOCUMENTS
// ============================================================

Table documents {
  id uuid [pk, default: `gen_random_uuid()`]

  uploaded_by_id uuid [not null]

  document_type varchar(50) [not null]

  file_url varchar(1000) [not null]
  original_filename varchar(255) [not null]

  mime_type varchar(100)
  file_size_bytes bigint

  related_object_type varchar(50)
  related_object_id uuid

  status varchar(20) [not null, default: 'active']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (uploaded_by_id, created_at)
    (related_object_type, related_object_id)
    (document_type, status)
  }

  // IMPLEMENTATION NOTE:
  // CHECK file_size_bytes > 0 when file_size_bytes is not null.
  // Validate file type, size, ownership, and access permissions.
  // Store files in private object storage and issue authorized URLs.
  //
  // related_object_type + related_object_id is polymorphic;
  // validate the referenced object in application logic.
}

Ref: documents.uploaded_by_id > users.id