# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=proptech_platform_db
DB_USER=proptech_platform_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS & Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_URL=http://localhost:5174

# Email
DEFAULT_FROM_EMAIL=noreply@proptech.local

# Throttling Rates
THROTTLE_RATE_REGISTRATION=5/minute
THROTTLE_RATE_EMAIL_VERIFICATION=10/minute
THROTTLE_RATE_RESEND_VERIFICATION=3/hour
THROTTLE_RATE_PASSWORD_RESET_REQUEST=3/hour
THROTTLE_RATE_LOGIN=10/minute
THROTTLE_RATE_GOOGLE_AUTH=10/minute
THROTTLE_RATE_TOKEN_REFRESH=30/minute
THROTTLE_RATE_PASSWORD_RESET_CONFIRM=5/minute

# Security
DJANGO_SECURE_SSL_REDIRECT=False

# Google OAuth
GOOGLE_CLIENT_ID=
